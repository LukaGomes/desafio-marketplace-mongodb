# Copie este arquivo para ".env" e ajuste se necessário.
# MongoDB local:
MONGO_URI=mongodb://localhost:27017/marketplace
# MongoDB Atlas (exemplo):
# MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/marketplace

# Seed e Tarefas (opcional; estes são os valores padrão).
# replicaSet=rs0 é necessário para as transações da Tarefa 4.
SEED_MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
SEED_DB_NAME=marketplace_seed
